{
  "name": "javshelf",
  "version": "2.0.1",
  "description": "JavShelf: 高分屏、本地多库、演员头像、流畅度优先的媒体库管理器",
  "main": "main/main.js",
  "private": true,
  "author": "JavShelf",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win dir --x64",
    "zip": "electron-builder --win zip --x64"
  },
  "devDependencies": {
    "electron": "44.4.3",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "undici": "^8.10.2"
  },
  "build": {
    "appId": "com.javshelf.library",
    "productName": "JavShelf",
    "artifactName": "JavShelf-v${version}-windows-x86_64.${ext}",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "files": [
      "main/**/*.js",
      "renderer/**/*",
      "extension/**/*",
      "build/icon.png",
      "build/icon.ico",
      "preload.js",
      "package.json",
      "LICENSE"
    ],
    "asar": false,
    "win": {
      "icon": "build/icon.ico",
      "target": [{ "target": "dir", "arch": ["x64"] }]
    }
  }
}
